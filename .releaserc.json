{
  "branches": [
    "main",
    {
      "name": "dev",
      "channel": "beta",
      "prerelease": "beta"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [],
        "successComment": false,
        "failComment": false,
        "labels": false,
        "releasedLabels": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "successCmd": "echo version=${nextRelease.version} >> $GITHUB_OUTPUT && echo released=true >> $GITHUB_OUTPUT"
      }
    ]
  ]
}
