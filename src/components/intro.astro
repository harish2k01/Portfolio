---
import "../styles/intro.css"
import { FaGithub, FaLinkedin, FaMedium } from "react-icons/fa6"

interface Props {
  id?: string
}

const { id } = Astro.props as Props
---

<>
  <div id={id} class="status-container">
    <div class="green-circle"></div>
    <span>Online</span>
  </div>
  <h1 class="text-4xl sm:text-5xl font-semibold mt-5 tracking-wider">
    Hi, I'm Harish
    <br />
    <span
      class="font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 mt-2 block"
      style={{ paddingBottom: "3px" }}
    >
      DevOps Engineer
    </span>
  </h1>
  <div class="button-group">
    <a href="https://www.linkedin.com/in/harish2k01/" target="_blank" rel="noopener noreferrer" class="button">
      <FaLinkedin className="button-icon" client:load />
      <span>LinkedIn</span>
    </a>
    <a href="https://github.com/harish2k01/" target="_blank" rel="noopener noreferrer" class="button">
      <FaGithub className="button-icon" client:load />
      <span>GitHub</span>
    </a>
    <a href="https://harish2k01.medium.com/" target="_blank" rel="noopener noreferrer" class="button">
      <FaMedium className="button-icon" client:load />
      <span>Medium</span>
    </a>
  </div>
  <p class="text-gray-400 text-lg tracking-wide mt-9">
    DevOps Engineer with 3+ years of experience focused on building reliable, scalable systems. I enjoy 
    solving challenges through infrastructure optimization, observability, and performance analysis. Outside 
    of work, I actively experiment with self-hosting and homelab infrastructure, running services and Kubernetes 
    clusters on my home server. I also share insights through technical blogs while continuously exploring new 
    technologies to improve system resilience and engineering practices.
  </p>
  <hr class="line" />
</>
