---
import "../styles/timeline.css"

interface Props {
  id?: string
}

const { id } = Astro.props as Props

// Map organization display names to their external URLs.
const orgLinks: Record<string, string | undefined> = {
  "Vikaasa School": "https://vikaasa.org/",
  Vuram: "https://vuram.com",
  VCET: "https://vcet.ac.in/",
  Workhall: "https://workhall.com/",
  NielsenIQ: "https://nielseniq.com",
}
---

<>
  <h2 id ={id} class="heading">My Timeline</h2>
  <div class="timeline-main">
    <div class="timeline">
      <ul>
        <li>
          <div class="timeline-content-left">
            <span class="date">01-Apr-2016</span>
            <p class="text-content">
              Completed 10th, ICSE{" "}
              {orgLinks["Vikaasa School"] ? (
                <a
                  class="org-link"
                  href={orgLinks["Vikaasa School"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open Vikaasa School website"
                >
                  <span class="text-gray-400">@Vikaasa School</span>
                </a>
              ) : (
                <span class="text-gray-400">@Vikaasa School</span>
              )}
            </p>
          </div>
        </li>
        <li>
          <div class="timeline-content-right">
            <span class="date">01-Apr-2018</span>
            <p>
              Completed 12th, ISC
              <br />
              {orgLinks["Vikaasa School"] ? (
                <a
                  class="org-link"
                  href={orgLinks["Vikaasa School"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open Vikaasa School website"
                >
                  <span class="text-gray-400">@Vikaasa School</span>
                </a>
              ) : (
                <span class="text-gray-400">@Vikaasa School</span>
              )}
            </p>
          </div>
        </li>
        <li>
          <div class="timeline-content-left">
            <span class="date">18-Oct-2021</span>
            <p class="text-content">
              Joined {orgLinks["Vuram"] ? (
                <a
                  class="org-link"
                  href={orgLinks["Vuram"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open Vuram website"
                >
                  <span class="text-gray-400">@Vuram</span>
                </a>
              ) : (
                <span class="text-gray-400">@Vuram</span>
              )}
              <br />
              as an Intern
            </p>
          </div>
        </li>
        <li>
          <div class="timeline-content-right">
            <span class="date">01-May-2022</span>
            <p>
              Graduated BE
              <br />
              in CSE {orgLinks["VCET"] ? (
                <a
                  class="org-link"
                  href={orgLinks["VCET"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open VCET website"
                >
                  <span class="text-gray-400">@VCET</span>
                </a>
              ) : (
                <span class="text-gray-400">@VCET</span>
              )}
            </p>
          </div>
        </li>
        <li>
          <div class="timeline-content-left">
            <span class="date">01-Jul-2022</span>
            <p class="text-content">
              Continued as an
              <br />
              Intern with {orgLinks["Workhall"] ? (
                <a
                  class="org-link"
                  href={orgLinks["Workhall"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open Workhall website"
                >
                  <span class="text-gray-400">@Workhall</span>
                </a>
              ) : (
                <span class="text-gray-400">@Workhall</span>
              )}
            </p>
          </div>
        </li>
        <li>
          <div class="timeline-content-right">
            <span class="date">01-Aug-2022</span>
            <p>
              Moved to Full Time{" "}
              {orgLinks["Workhall"] ? (
                <a
                  class="org-link"
                  href={orgLinks["Workhall"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open Workhall website"
                >
                  <span class="text-gray-400">@Workhall</span>
                </a>
              ) : (
                <span class="text-gray-400">@Workhall</span>
              )} as Associate
              Software Engineer
            </p>
          </div>
        </li>
        <li>
          <div class="timeline-content-left">
            <span class="date">01-Feb-2024</span>
            <p class="text-content">
              Promoted as an
              <br />
              Automation Engineer, Quality Enginnering {orgLinks["Workhall"] ? (
                <a
                  class="org-link"
                  href={orgLinks["Workhall"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open Workhall website"
                >
                  <span class="text-gray-400">@Workhall</span>
                </a>
              ) : (
                <span class="text-gray-400">@Workhall</span>
              )}
            </p>
          </div>
        </li>
        <li>
          <div class="timeline-content-right">
            <span class="date">09-Mar-2026</span>
            <p>
              Moved to {" "}
              {orgLinks["NielsenIQ"] ? (
                <a
                  class="org-link"
                  href={orgLinks["NielsenIQ"]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open NielsenIQ website"
                >
                  <span class="text-gray-400">@NielsenIQ</span>
                </a>
              ) : (
                <span class="text-gray-400">@NielsenIQ</span>
              )} as
              <br />
              Site Reliability Engineer
            </p>
          </div>
        </li>
      </ul>
    </div>
  </div>
  <hr class="line" style={{ marginTop: "2.5rem" }} />
</>
