pipeline {
    agent any

    parameters {
        string(name: 'VERSION', defaultValue: '', description: 'Semantic version like 1.2.3')
        string(name: 'GITHUB_SHA', defaultValue: '', description: 'GitHub commit SHA')
        string(name: 'SERVER_URL', defaultValue: '', description: 'URL of the server')
    }

    environment {
        GITHUB_CREDENTIALS = credentials('github-creds')
        DISCORD_WEBHOOK = credentials('discord-webhook')
        IMAGE_NAME = 'ghcr.io/harish2k01/portfolio'
        SERVER_CREDENTIALS = credentials('ct-essentials-creds')
    }

    stages {
        stage('Validate Production Version') {
            steps {
                script {
                    if (!params.VERSION || params.VERSION.contains('-')) {
                        error('VERSION must be a stable release like 1.2.3')
                    }
                }
            }
        }

        stage('Checkout Code') {
            steps {
                sh '''
                git remote set-url origin https://${GITHUB_CREDENTIALS_USR}:${GITHUB_CREDENTIALS_PSW}@github.com/harish2k01/Portfolio.git
                git fetch --tags
                git checkout v${VERSION}
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build \
                  --label "org.opencontainers.image.source=https://github.com/harish2k01/Portfolio" \
                  --label "org.opencontainers.image.description=Portfolio" \
                  --label "org.opencontainers.image.licenses=MIT" \
                  -t $IMAGE_NAME:$VERSION .
                docker tag $IMAGE_NAME:$VERSION $IMAGE_NAME:latest
                '''
            }
        }

        stage('Push to GHCR') {
            steps {
                sh '''
                echo "$GITHUB_CREDENTIALS_PSW" | docker login ghcr.io -u "$GITHUB_CREDENTIALS_USR" --password-stdin
                docker push $IMAGE_NAME:$VERSION
                docker push $IMAGE_NAME:latest
                docker logout
                '''
            }
        }

        stage('Make GHCR Tags Public') {
            steps {
                script {
                    sh '''
                    VERSION_ID=$(curl -s -H "Authorization: token $GITHUB_CREDENTIALS_PSW" \
                        -H "Accept: application/vnd.github+json" \
                        https://api.github.com/user/packages/container/portfolio/versions |
                        jq '.[] | select(.metadata.container.tags[] | contains("${VERSION}")) | .id')

                    LATEST_ID=$(curl -s -H "Authorization: token $GITHUB_CREDENTIALS_PSW" \
                        -H "Accept: application/vnd.github+json" \
                        https://api.github.com/user/packages/container/portfolio/versions |
                        jq '.[] | select(.metadata.container.tags[] | contains("latest")) | .id')

                    if [ ! -z "$VERSION_ID" ]; then
                        curl -X PATCH \
                            -H "Authorization: token $GITHUB_CREDENTIALS_PSW" \
                            -H "Accept: application/vnd.github+json" \
                            https://api.github.com/user/packages/container/portfolio/versions/$VERSION_ID/visibility \
                            -d '{"visibility":"public"}'
                    fi

                    if [ ! -z "$LATEST_ID" ]; then
                        curl -X PATCH \
                            -H "Authorization: token $GITHUB_CREDENTIALS_PSW" \
                            -H "Accept: application/vnd.github+json" \
                            https://api.github.com/user/packages/container/portfolio/versions/$LATEST_ID/visibility \
                            -d '{"visibility":"public"}'
                    fi
                    '''
                }
            }
        }

        stage('Link Package to Repository') {
            steps {
                script {
                    sh '''
                    curl -X POST \
                      -H "Authorization: token $GITHUB_CREDENTIALS_PSW" \
                      -H "Accept: application/vnd.github.v3+json" \
                      -H "Content-Type: application/json" \
                      -d '{"repository": "harish2k01/Portfolio"}' \
                      "https://api.github.com/user/packages/container/portfolio/versions"
                    '''
                }
            }
        }

        stage('Deploy Production Image') {
            steps {
                sh '''
                sshpass -p "$SERVER_CREDENTIALS_PSW" ssh -o StrictHostKeyChecking=no "$SERVER_CREDENTIALS_USR"@"$SERVER_URL" '
                    cd apps/portfolio/prod &&
                    sudo docker compose down &&
                    sudo docker rmi $IMAGE_NAME:latest || true &&
                    sudo docker compose up -d
                '
                '''
            }
        }
    }

    post {
        success {
            script {
                sendDiscordNotification('SUCCESS', "Production build `${params.VERSION}` deployed successfully.")
            }
        }
        failure {
            script {
                sendDiscordNotification('FAILURE', "Production build `${params.VERSION}` failed.")
            }
        }
    }
}

def sendDiscordNotification(String status, String message) {
    def color = status == 'SUCCESS' ? 3066993 : 15158332
    def payload = """
    {
      "username": "Jenkins Bot",
      "embeds": [{
        "title": "Production Build ${status}",
        "description": "${message}",
        "color": ${color},
        "fields": [
          {"name": "Version", "value": "${params.VERSION}", "inline": true},
          {"name": "Environment", "value": "Production", "inline": true}
        ],
        "timestamp": "${new Date().format("yyyy-MM-dd'T'HH:mm:ssXXX")}"
      }]
    }
    """
    sh """curl -X POST -H 'Content-Type: application/json' -d '${payload}' $DISCORD_WEBHOOK"""
}
