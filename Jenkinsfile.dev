pipeline {
    agent any

    parameters {
        string(name: 'VERSION', defaultValue: '', description: 'Semantic version like 1.2.3-beta.0')
        string(name: 'GITHUB_SHA', defaultValue: '', description: 'GitHub commit SHA')
        string(name: 'SERVER_URL', defaultValue: '', description: 'URL of the server')
    }

    environment {
        GITHUB_CREDENTIALS = credentials('github-creds')
        DISCORD_WEBHOOK = credentials('discord-webhook')
        IMAGE_NAME = 'ghcr.io/harish2k01/portfolio'
        SERVER_CREDENTIALS = credentials('ct-essentials-creds')
    }

    stages {
        stage('Validate Pre-release Version') {
            steps {
                script {
                    if (!params.VERSION || !params.VERSION.contains('-')) {
                        error('VERSION must be a valid pre-release like 1.2.3-beta.0')
                    }
                }
            }
        }

        stage('Checkout Code') {
            steps {
                sh '''
                git remote set-url origin https://${GITHUB_CREDENTIALS_USR}:${GITHUB_CREDENTIALS_PSW}@github.com/harish2k01/Portfolio.git
                git fetch --tags
                git checkout v${VERSION}
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build \
                  --label "org.opencontainers.image.source=https://github.com/harish2k01/Portfolio" \
                  --label "org.opencontainers.image.description=Portfolio" \
                  --label "org.opencontainers.image.licenses=MIT" \
                  -t $IMAGE_NAME:$VERSION .
                docker tag $IMAGE_NAME:$VERSION $IMAGE_NAME:dev
                '''
            }
        }

        stage('Push to GHCR') {
            steps {
                sh '''
                echo "$GITHUB_CREDENTIALS_PSW" | docker login ghcr.io -u "$GITHUB_CREDENTIALS_USR" --password-stdin
                docker push $IMAGE_NAME:$VERSION
                docker push $IMAGE_NAME:dev
                docker logout
                '''
            }
        }

        stage('Deploy Development Image') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'ct-essentials-creds', usernameVariable: 'SERVER_USER', passwordVariable: 'SERVER_PASS')]) {
                        sh '''
                            sshpass -p "${SERVER_PASS}" ssh -o StrictHostKeyChecking=no ${SERVER_USER}@${SERVER_URL} "
                            cd apps/portfolio/dev &&
                            sudo docker compose down &&
                            sudo docker rmi ${IMAGE_NAME}:dev || true &&
                            echo '${GITHUB_CREDENTIALS_PSW}' | docker login ghcr.io -u '${GITHUB_CREDENTIALS_USR}' --password-stdin &&
                            sudo docker compose up -d
                            "
                        '''
                    }
                }
            }
        }

        stage('Clean Docker Images') {
            steps {
                sh '''
                sudo docker system prune -a --volumes -f
                '''
            }
        }

    }

    post {
        success {
            script {
                sendDiscordNotification('SUCCESS', "Dev build `${params.VERSION}` deployed successfully.")
            }
        }
        failure {
            script {
                sendDiscordNotification('FAILURE', "Dev build `${params.VERSION}` failed.")
            }
        }
    }
}

def sendDiscordNotification(String status, String message) {
    def color = status == 'SUCCESS' ? 3066993 : 15158332
    def payload = """
    {
      "username": "Jenkins Bot",
      "embeds": [{
        "title": "Dev Build ${status}",
        "description": "${message}",
        "color": ${color},
        "fields": [
          {"name": "Version", "value": "${params.VERSION}", "inline": true},
          {"name": "Environment", "value": "Dev", "inline": true}
        ],
        "timestamp": "${new Date().format("yyyy-MM-dd'T'HH:mm:ssXXX")}" 
      }]
    }
    """
    sh """curl -X POST -H 'Content-Type: application/json' -d '${payload}' $DISCORD_WEBHOOK"""
}
